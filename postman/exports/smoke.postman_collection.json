        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing JWT rejected', () => pm.response.to.have.status(401));",
              "pm.test('Normalized error', () => {const e=pm.response.json(); pm.expect(e.statusCode).to.equal(401); for(const k of ['message','error','path','timestamp']) pm.expect(e).to.have.property(k);});"
            ]
          }
        }
      ],
      "response": []
