  "item": [
    {
      "name": "GET /",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "{{base_url}}"
          ],
          "query": []
        },
        "description": "Source: src/app.controller.ts\n",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "pm.test('Service healthy', () => pm.expect(pm.response.json()).to.deep.equal({status:'ok',service:'babki-api'}));"
            ]
          }
        }
      ],
      "response": []
