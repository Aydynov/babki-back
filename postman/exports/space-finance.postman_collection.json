{
  "info": {
    "name": "Babki Space Finance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Disposable target only. Registers a zero-space user, explicitly creates empty spaces, exercises financial operations and rejects cross-space references and removed routes."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.get('base_url');",
          "if (!base || !/^https?:\\/\\//.test(base)) throw new Error('Select an environment and set base_url');",
          "if (!pm.variables.get('run_id')) pm.variables.set('run_id', pm.variables.replaceIn('{{$guid}}'));",
          "pm.variables.set('now', new Date().toISOString());",
          "pm.variables.set('future_date', new Date(Date.now() + 30 * 86400000).toISOString());",
          "if (!['GET','HEAD','OPTIONS'].includes(pm.request.method) && pm.variables.get('allow_mutations') !== 'true') {",
          "  pm.execution.skipRequest();",
          "  throw new Error('Set allow_mutations=true only for a disposable test target');",
          "}",
          "if (!pm.variables.get('workflow_initialized')) {",
          "  pm.variables.set('workflow_initialized', 'true');",
          "  pm.variables.set('email', 'postman-' + pm.variables.get('run_id') + '@example.test');",
          "  pm.variables.set('password', pm.variables.replaceIn('{{$guid}}') + 'Aa1!');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 200 && pm.response.code < 300 && /\\/spaces\\/[^/]+\\/(accounts|incomes|expenses|transactions|transfers|expense-categories|expense-limits|plans|debts)(?:\\/|$)/.test(pm.variables.replaceIn(pm.request.url.toString())) && pm.response.text()) {",
          "  const body = pm.response.json();",
          "  pm.test('Financial DTO omits ownership aliases and storage counters', () => {",
          "    function check(value) {",
          "      if (Array.isArray(value)) return value.forEach(check);",
          "      if (!value || typeof value !== 'object') return;",
          "      ['ownerType', 'ownerId', 'mutationVersion', 'lockVersion', '__v'].forEach(key => pm.expect(value).not.to.have.property(key));",
          "      Object.values(value).forEach(check);",
          "    }",
          "    check(body);",
          "  });",
          "  if (body._id) pm.test('Financial resource belongs to selected space', () => pm.expect(body.spaceId).to.equal(pm.variables.get('space_id')));",
          "}"
        ]
      }
    }
  ],
