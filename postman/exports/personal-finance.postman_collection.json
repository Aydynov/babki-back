{
  "info": {
    "name": "Babki Personal Finance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Disposable target only. Creates a unique user, account, category, income and expense, cancels transactions and archives the account/category. The test user remains; account-deletion requires an explicit manual request."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.get('base_url');",
          "if (!base || !/^https?:\\/\\//.test(base)) throw new Error('Select an environment and set base_url');",
          "if (!pm.variables.get('run_id')) pm.variables.set('run_id', pm.variables.replaceIn('{{$guid}}'));",
          "pm.variables.set('now', new Date().toISOString());",
          "pm.variables.set('future_date', new Date(Date.now() + 30 * 86400000).toISOString());",
          "if (!['GET','HEAD','OPTIONS'].includes(pm.request.method) && pm.variables.get('allow_mutations') !== 'true') {",
          "  pm.execution.skipRequest();",
          "  throw new Error('Set allow_mutations=true only for a disposable test target');",
          "}",
          "if (!pm.variables.get('workflow_initialized')) {",
          "  pm.variables.set('workflow_initialized', 'true');",
          "  pm.variables.set('email', 'postman-' + pm.variables.get('run_id') + '@example.test');",
          "  pm.variables.set('password', pm.variables.replaceIn('{{$guid}}') + 'Aa1!');",
          "}"
        ]
      }
    }
  ],
