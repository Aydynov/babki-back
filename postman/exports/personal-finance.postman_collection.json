    {
      "name": "POST /auth/register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "register"
          ],
          "query": []
        },
        "description": "Source: src/modules/auth/auth.controller.ts\nOptional body fields: notes",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Runner\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"currency\": \"RUB\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  if (body.accessToken) pm.variables.set('access_token', body.accessToken);",
              "  else { pm.variables.unset('access_token'); if (body.challengeToken) pm.variables.set('challenge_token', body.challengeToken); }",
              "}"
            ]
          }
        }
      ]
    },
